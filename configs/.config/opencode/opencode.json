{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/home/marc/.config/opencode/AGENTS.md"],
  "skills": ["~/dev/opencode-skills/skills"],
  "autoupdate": true,
  "lsp": false,
  "plugin": ["opencode-gemini-auth@latest"],
  "provider": {
    "google": {
      "options": {
        "projectId": "keeling-project"
      }
    },
    "openai": {
      "models": {
        "gpt-6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "small_model": "openai/gpt-6-luna",
  "permission": {
    "external_directory": {
      "~/.config/browser-harness/tmp/*": "allow",
      "~/Downloads/tmp/*": "allow",
      "/home/marc/dev-obit/*": "allow"
    }
  },
  "agent": {
    "build": { "model": "openai/gpt-6.1-sol", "reasoningEffort": "low" },
    "plan": { "model": "openai/gpt-6.1-sol", "reasoningEffort": "low" },
    "general": { "model": "openai/gpt-6.1-sol", "reasoningEffort": "low" },
    "explore": { "model": "openai/gpt-6-luna", "reasoningEffort": "max" },
    "scout": { "model": "openai/gpt-6-luna", "reasoningEffort": "max" }
  },
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?read_only=true"
      }
    }
  }
}
