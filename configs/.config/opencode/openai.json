{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "medium"
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "max"
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "max"
    }
  }
}
