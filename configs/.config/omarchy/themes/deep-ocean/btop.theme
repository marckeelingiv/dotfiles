# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#060e1a"

# Main text color
theme[main_fg]="#b8d8e8"

# Title color for boxes
theme[title]="#9575cd"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#00bcd4"

# Background color of selected item in processes box
theme[selected_bg]="#1e3a4f"

# Foreground color of selected item in processes box
theme[selected_fg]="#b8d8e8"

# Color of inactive/disabled text
theme[inactive_fg]="#1e3a4f"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#9575cd"

# Box outline and divider line color
theme[cpu_box]="#3ecfb6"
theme[mem_box]="#3ecfb6"
theme[net_box]="#3ecfb6"
theme[proc_box]="#3ecfb6"
theme[div_line]="#1e3a4f"

# Gradient for all meters and graphs
theme[temp_start]="#80deea"
theme[temp_mid]="#2979ff"
theme[temp_end]="#3ecfb6"


theme[cpu_start]="#80deea"
theme[cpu_mid]="#2979ff"
theme[cpu_end]="#3ecfb6"


theme[free_start]="#2979ff"
theme[free_mid]="#f0a843"
theme[free_end]="#f0a843"


theme[cached_start]="#f0a843"
theme[cached_mid]="#f0a843"
theme[cached_end]="#f0a843"


theme[available_start]="#80deea"
theme[available_mid]="#80deea"
theme[available_end]="#80deea"


theme[used_start]="#3ecfb6"
theme[used_mid]="#3ecfb6"
theme[used_end]="#3ecfb6"


theme[download_start]="#f0a843"
theme[download_mid]="#80deea"
theme[download_end]="#2979ff"


theme[upload_start]="#f0a843"
theme[upload_mid]="#80deea"
theme[upload_end]="#2979ff"
